{
  "name": "todo-voice-agent-workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "To-do voice agent",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          "node_modules": true
        }
      }
    }
  }
}
